# Apache (hosting tradicional: Hostinger, IONOS, SiteGround, Raiola, Webempresa…).
# Al migrar, sube este archivo junto al CONTENIDO de site/ (dentro de public_html/).
# Si el panel ya fuerza HTTPS, puedes borrar el bloque de RewriteRule.

# Página de error propia
ErrorDocument 404 /404.html

# Forzar HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compresión de texto (HTML, CSS, JS, SVG, XML)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

# Tiempos de caché (CSS y JS llevan ?v=N en el HTML, así que pueden durar un año)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

# Tipos que algunos servidores antiguos no conocen
AddType font/woff2 .woff2
AddType image/webp .webp

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# No listar el contenido de las carpetas
Options -Indexes
